# .env.example — copy to .env.local and fill in real values before running locally.
# All vars marked [required] will cause the app to error on first use if missing.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co  # [required]

# Public anon key (safe for client-side). Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # [required]

# Service role key — server-side only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # [required]

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...  # [required] (use sk_test_... for local dev)

# Webhook signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint
# Required events: checkout.session.completed, checkout.session.expired,
#                  payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...  # [required]

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# API key from resend.com dashboard
RESEND_API_KEY=re_...  # [required]

# The address emails are sent FROM. Must be a verified sender in Resend.
FROM_EMAIL=bookings@thedrivingschooldublin.com  # [required]

# The instructor's inbox — booking notifications and ADI copies go here.
ADI_EMAIL=instructor@thedrivingschooldublin.com  # [required]

# ─── Admin ───────────────────────────────────────────────────────────────────
# Long random secret (min 16 chars) used to protect /admin and /api/admin/* routes.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-secret  # [required]

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Service account email from Google Cloud Console → IAM → Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-sync@your-project.iam.gserviceaccount.com  # [optional]

# Private key from the service account JSON. Newlines must be escaped as \n.
# Tip: cat key.json | python3 -c "import json,sys; print(json.load(sys.stdin)['private_key'].replace('\n','\\n'))"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"  # [optional]

# Calendar ID to write events to. Usually the instructor's Google account email.
GOOGLE_CALENDAR_ID=instructor@gmail.com  # [optional]

# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL used in emails and Stripe success/cancel redirect URLs.
# In local dev, set to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://thedrivingschooldublin.com  # [optional, has default]

# Timezone for formatting dates in emails and logs. Default: Europe/Dublin
TIMEZONE=Europe/Dublin  # [optional]

# ─── Error monitoring ────────────────────────────────────────────────────────
# Sentry DSN for error tracking. Leave empty to disable.
SENTRY_DSN=  # [optional]
