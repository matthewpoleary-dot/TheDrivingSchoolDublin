# =============================================================================
# The Driving School Dublin: environment
# =============================================================================
# Copy to .env.local for development. In production these go in the Vercel
# project settings. Full walkthrough: docs/SETUP.md
#
# The site degrades rather than crashes when these are missing:
#   - No Supabase  -> booking falls back to "ring or WhatsApp us"
#   - No Stripe    -> bookings confirm immediately with no deposit taken
#   - No Resend    -> bookings still save, confirmation emails are skipped
#   - No Google    -> online slots pause to prevent paid double-bookings
# Calendar reads fail closed deliberately; the phone and WhatsApp routes remain.
# =============================================================================

# --- Site --------------------------------------------------------------------
# No trailing slash. Used for canonical URLs, emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://thedrivingschooldublin.com
TIMEZONE=Europe/Dublin


# --- Supabase (required for online booking) ----------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRET. Server-side only, never exposed to the browser, bypasses row-level
# security. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# --- Stripe (required to take deposits or full payments) --------------------
# Use sk_test_... and the test webhook secret until you have run a real
# end-to-end booking. Swap to live keys only after that passes.
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...


# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend, or delivery will fail silently.
FROM_EMAIL=bookings@thedrivingschooldublin.com
# Where new-booking and enquiry notifications go.
ADI_EMAIL=thedrivingschooldublin@gmail.com


# --- Google Calendar (two-way sync) ------------------------------------------
# A service account, with the instructor's calendar SHARED to the address
# below with "Make changes to events". See docs/SETUP.md step 4.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tds-calendar@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes. Newlines may be literal \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Usually the instructor's Google account email.
GOOGLE_CALENDAR_ID=conor@example.com


# --- Admin -------------------------------------------------------------------
# The password for /admin. Long and random. A short one is the weakest link in
# the whole system, since it guards every customer's name, phone and address.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with: openssl rand -hex 32
# Changing it logs everyone out immediately, which is how you revoke access.
ADMIN_SESSION_SECRET=


# --- Cron --------------------------------------------------------------------
# Protects /api/cron/maintenance. Vercel sends it automatically once set.
# Generate with: openssl rand -hex 32
CRON_SECRET=
